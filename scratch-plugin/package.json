{
  "name": "dsh-disk-space-plugin",
  "version": "0.1.0",
  "description": "A DeepSeek Harness tool that reports host filesystem capacity without invoking a shell.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.2-alpha.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.6-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.2-alpha.2",
    "@types/node": "^22.20.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.6-alpha.1"
  },
  "license": "MIT"
}
